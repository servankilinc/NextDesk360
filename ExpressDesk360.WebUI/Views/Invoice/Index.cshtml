
@using ExpressDesk360.WebUI.Models.ViewModels.Invoice
@model InvoiceViewModel
@{
    ViewData["Title"] = "Invoices";
}

@await Html.PartialAsync("Partials/Toolbar", new Breadcrum
{
    BreadcrumbItems = new List<BreadcrumbItem>
    {
        new BreadcrumbItem { Title = "Home", Path = Url.Action("Index", "Home") },
    },
    PageName = ViewData["Title"]?.ToString() ?? "Page"
})

<link href="~/metronic/plugins/custom/datatables/datatables.bundle.css" rel="stylesheet" />

<div class="card card-flush">
    <div class="card-header align-items-center py-5 gap-2 gap-md-5">
        <div class="card-title">
            <div class="menu menu-sub menu-sub-dropdown mt-2 w-75 w-lg-500px" data-kt-menu="true">
                <div class="px-7 py-5">
                    <div class="fs-5 text-gray-900 fw-bold">Filter Options</div>
                </div>
                <div class="separator border-gray-200"></div>
                <div class="px-7 py-5">
                    
                    <div class="mb-10">
                        <label class="form-label fw-semibold" for="slct_invoiceTypeId">Invoice Type</label>
                        <select id="slct_invoiceTypeId" class="autoInitSelect2 form-select form-select-sm form-select-solid" name="InvoiceTypeId" asp-items="Model.InvoiceTypeIds" data-control="select2"  data-allow-clear="true">
                            <option></option>
                        </select>
                    </div>
                    <div class="mb-10">
                        <label class="form-label fw-semibold" for="inpt_invoiceNo">Invoice No</label>
                        <input id="inpt_invoiceNo" class="form-control form-control-sm form-control-solid" name="InvoiceNo" type="text"/>
                    </div>
                    <div class="mb-10">
                        <label class="form-label fw-semibold" for="slct_sellerCompanyId">Seller Company</label>
                        <select id="slct_sellerCompanyId" class="autoInitSelect2 form-select form-select-sm form-select-solid" name="SellerCompanyId" asp-items="Model.SellerCompanyIds" data-control="select2"  data-allow-clear="true">
                            <option></option>
                        </select>
                    </div>
                    <div class="mb-10">
                        <label class="form-label fw-semibold" for="slct_buyerCompanyId">Buyer Company</label>
                        <select id="slct_buyerCompanyId" class="autoInitSelect2 form-select form-select-sm form-select-solid" name="BuyerCompanyId" asp-items="Model.BuyerCompanyIds" data-control="select2"  data-allow-clear="true">
                            <option></option>
                        </select>
                    </div>
                    <div class="mb-10">
                        <label class="form-label fw-semibold" for="dtpick_paymentDate">Payment Date</label>
                        <input id="dtpick_paymentDate" class="autoInitFlatPicker form-control form-control-sm form-control-solid" name="PaymentDate"/>
                    </div>
                    <div class="mb-10">
                        <div class="form-check form-switch form-switch-sm form-check-custom form-check-solid">
                            <input name="IsDeleted" value="false" type="hidden" />
                            <input name="IsDeleted" value="true" type="checkbox" class="form-check-input" />
                            <span class="form-check-label fs-sm">Include Deleted</span>
                        </div>
                    </div>
            
                    <div class="d-flex justify-content-end">
                        <button type="reset" class="btn btn-sm btn-light btn-active-light-primary me-2" data-kt-menu-dismiss="true">Reset</button>
                        <button type="button" onclick="InitilazeTable(this)" class="btn btn-sm btn-primary" data-kt-menu-dismiss="true">Apply</button>
                    </div>
                </div>
            </div>
            <button class="btn btn-sm btn-flex btn-light-dark fw-bold" data-kt-menu-trigger="click" data-kt-menu-placement="bottom-start">
                <i class="ki-duotone ki-filter fs-6 text-muted me-1"><span class="path1"></span><span class="path2"></span></i>
                Filter
            </button>
        </div>
    </div>
    <div class="card-body p-4 pt-0">
        <table id="main_table" class="table align-middle table-row-dashed fs-6 gy-5">
            <thead>
                <tr class="text-start text-gray-500 fw-bold fs-7 text-uppercase gs-0">
                    					<th>Invoice Type</th>
					<th>Invoice No</th>
					<th>Item Number</th>
					<th>Seller Company</th>
					<th>Buyer Company</th>
					<th>Payment Date</th>
					<th>Delivery Date</th>
					<th>Total Price</th>
					<th>Discount Amount 1</th>
					<th>Discount Amount 2</th>
					<th>Discount Rate 1</th>
					<th>Discount Rate 2</th>
					<th>Tax Total</th>
					<th>Grand Total</th>
					<th>Currency</th>
					<th>Exchange Rate</th>
					<th>Create Date</th>
					<th>Last Update Date</th>
					<th>Status</th>
					<th>Delete Date</th>
					<th>Actions</th>

                </tr>
            </thead>
            <tbody class="fw-semibold text-gray-600">
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/metronic/plugins/custom/datatables/datatables.bundle.js"></script>

    <script>

        let mainTable;

        $(document).ready(function(){
            InitilazeTable();
        })

        function InitilazeTable(btn) {
            mainTable = DatatableManager.Create({
                serverSide: true,
                tableId: 'main_table',
                path: 'Invoice/DatatableServerSide',
                method: 'Post',
                buttonElement: btn,
                
                requestData: {
                    filter: {
                        operator: 'base',
                        logic: 'and',
                        filters: [
                             
                            {
                                operator: 'eq',
                                field: 'InvoiceTypeId',
                                value: $("select[name='InvoiceTypeId']").val()
                            }
                , 
                            {
                                operator: 'contains',
                                field: 'InvoiceNo',
                                value: $("input[name='InvoiceNo']").val()
                            }
                , 
                            {
                                operator: 'eq',
                                field: 'SellerCompanyId',
                                value: $("select[name='SellerCompanyId']").val()
                            }
                , 
                            {
                                operator: 'eq',
                                field: 'BuyerCompanyId',
                                value: $("select[name='BuyerCompanyId']").val()
                            }
                , 
                            {
                                operator: 'eq',
                                field: 'PaymentDate',
                                value: $("input[name='PaymentDate']").val()
                            }
                , 
                            {
                                operator: 'base',
                                logic: 'or',
                                filters: [
                                    {
                                        operator: 'eq',
                                        field: 'isDeleted',
                                        value: false,
                                    },
                                    {
                                        operator: 'eq',
                                        field: 'isDeleted',
                                        value: $('input[name="IsDeleted"]:checked').prop("checked") || false,
                                    }
                                ]
                            }
            
                        ]
                    }
                },
        
                columns: [
                    					{ data: 'InvoiceTypeId' },
					{ data: 'InvoiceNo' },
					{ data: 'ItemNumber' },
					{ data: 'SellerCompanyId' },
					{ data: 'BuyerCompanyId' },

                    {
                        data: 'PaymentDate',
                        render: function (data) {
                            if(data == null) return '';
                            return moment(data).format('DD.MM.YYYY HH:mm');
                        }
                    },
                    {
                        data: 'DeliveryDate',
                        render: function (data) {
                            if(data == null) return '';
                            return moment(data).format('DD.MM.YYYY HH:mm');
                        }
                    },					{ data: 'TotalPrice' },
					{ data: 'DiscountAmount1' },
					{ data: 'DiscountAmount2' },
					{ data: 'DiscountRate1' },
					{ data: 'DiscountRate2' },
					{ data: 'TaxTotal' },
					{ data: 'GrandTotal' },
					{ data: 'CurrencyId' },
					{ data: 'ExchangeRate' },

                    {
                        data: 'CreateDateUtc',
                        render: function (data) {
                            if(data == null) return '';
                            return moment(data).format('DD.MM.YYYY HH:mm');
                        }
                    },
                    {
                        data: 'UpdateDateUtc',
                        render: function (data) {
                            if(data == null) return '';
                            return moment(data).format('DD.MM.YYYY HH:mm');
                        }
                    },
                    {
                        data: 'isDeleted',
                        render: function (data) {
                            if(data == true) return (`<span class="badge rounded-pill bg-label-danger"><i class="fa-solid fa-xmark"></i></span>`);
                            else if(data == false) return (`<span class="badge rounded-pill bg-label-success"><i class="fa-solid fa-check"></i></span>`);
                            else return ('');
                        }
                    },
                    {
                        data: 'deletedDateUtc',
                        render: function (data) {
                            if(data == null) return '';
                            return moment(data).format('DD.MM.YYYY HH:mm');
                        }
                    },
                    {
                        data: null,
                        defaultContent: '',
                        searchable: false,
                        createdCell: function (td, cellData, rowData, row, col)
                        {
                            let deleteHandleButton = rowData.isDeleted == true ?
                                HelperService.UndoDeleteButtonTable({ requestUrl: 'Invoice/Restore', requestData: { "id": rowData.id }, pageTable: mainTable }) :
                                HelperService.DeleteButtonTable({requestUrl: 'Invoice/Delete', requestData: { "id": rowData.id }, pageTable: mainTable });

                            DatatableManager.AppendRowButtons(td,
                            [
                                HelperService.UpdateButtonTable({
                                    title: 'Update Invoice Informations',
                                    formGetterUrl: 'Invoice/Update',
                                    requestData: {
                                        "id": rowData.id
                                    },
                                    pageTable: mainTable
                                }),
                                deleteHandleButton
                            ]);
                        }
                    }
                ],
                customButtons:
                [  
                    {
                        text: '<span class="dynamic-content"><i class="fa-solid fa-file-circle-plus me-2"></i>Add New Invoice</span>',
                        className: 'btn btn-primary mx-2',
                        action: (e_btn) =>
                        {
                            HelperService.InsertModal({
                                title: 'Add New Invoice',
                                formGetterUrl: 'Invoice/Create',
                                e_btn: e_btn.currentTarget,
                                pageTable: mainTable
                            })
                        }
                    }
                ]
            })
        }
    </script>
}
