@using ExpressDesk360.WebUI.Models.UI
@model Breadcrum

@*
	Rendered server-side from inside the header (Components/Header/Default.cshtml).
	Pages hand the model over through ViewData["Breadcrumb"]; _Layout passes it to the
	Header view component. No KTSwapper, no client-side DOM move.
*@

@if (Model != null)
{
	var heading = string.IsNullOrWhiteSpace(Model.Title) ? Model.PageName : Model.Title;

	<div class="page-title d-flex flex-column align-items-start justify-content-center flex-wrap me-lg-2">
		<!--begin::Heading-->
		<h1 class="text-gray-900 fw-bold my-0 fs-2">@heading</h1>
		<!--end::Heading-->
		<!--begin::Breadcrumb-->
		<ul class="breadcrumb fw-semibold fs-base my-1">
			@if (Model.BreadcrumbItems != null)
			{
				@foreach (var item in Model.BreadcrumbItems)
				{
					<li class="breadcrumb-item text-muted">
						<a href="@item.Path" class="text-muted text-hover-primary">@item.Title</a>
					</li>
				}
			}
			<li class="breadcrumb-item text-gray-900">@Model.PageName</li>
		</ul>
		<!--end::Breadcrumb-->
	</div>
}
