@{
    // var currentUrl = Context.GetUrl();
    // var lightMode = Context.GetLightMode();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ExpressDesk360</title>

    <partial name="./Sections/_LayoutHeader.cshtml" />
</head>
@* Auth/error pages have no header or aside, so none of demo7's layout body classes apply.
   The inline background-image was also overriding the per-page <style> backgrounds. *@
<body id="kt_body" class="auth-bg">

    <!--begin::Root-->
    <div class="d-flex flex-column flex-root">
        <main role="main" class="d-flex flex-column flex-column-fluid">
            @RenderBody()
        </main>
    </div>
    <!--end::Root-->


    <partial name="./Sections/_LayoutScripts.cshtml" />

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>