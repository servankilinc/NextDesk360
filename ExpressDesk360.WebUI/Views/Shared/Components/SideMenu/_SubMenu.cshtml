@model MenuItem
@{
    string itemClass = "menu-item";
    if (Model.HasActiveChild) itemClass += " here show";
}

<!--begin::Item-->
<div class="d-flex align-items-center mb-7 @(Model.IsActive ? "active" : "")">
    <div class="symbol symbol-50px me-5">
        <span class="symbol-label bg-light-@(Model.CollorTheme)">
            @Html.Raw(Model.Icon)
        </span>
    </div> 
    <div class="d-flex flex-column">
        <a href="@Model.Path" target="@(Model.Target)" class="text-gray-800 text-hover-primary fs-6 fw-bold">@Model.Title</a>
        <span class="text-muted fw-bold">@Model.Title</span>
    </div> 
</div>
<!--end::Item-->


