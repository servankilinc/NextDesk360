
@using ExpressDesk360.WebUI.Models.ViewModels.Project
@model ProjectCreateViewModel
@{
	Layout = null;
}

<form asp-controller="Project" asp-action="Create" method="post"> 
	<div class="row row-gap-4 m-2">
        
        <div class="col-md-6">
            <label class="form-label fw-semibold" asp-for="CreateModel.Name">Name</label>
            <input class="form-control form-control-solid" asp-for="CreateModel.Name" type="text"/>
            <span class="form_validation_feedback" asp-validation-for="CreateModel.Name"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold" asp-for="CreateModel.StartDate">Start Date</label>
            <input class="autoInitFlatPicker form-control form-control-solid" asp-for="CreateModel.StartDate"/>
            <span class="form_validation_feedback" asp-validation-for="CreateModel.StartDate"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold" asp-for="CreateModel.Deadline">Deadline</label>
            <input class="autoInitFlatPicker form-control form-control-solid" asp-for="CreateModel.Deadline"/>
            <span class="form_validation_feedback" asp-validation-for="CreateModel.Deadline"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold" asp-for="CreateModel.Description">Description</label>
            <input class="form-control form-control-solid" asp-for="CreateModel.Description" type="text"/>
            <span class="form_validation_feedback" asp-validation-for="CreateModel.Description"></span>
        </div>
	</div>
</form>