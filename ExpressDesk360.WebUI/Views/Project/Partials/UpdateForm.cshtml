
@using ExpressDesk360.WebUI.Models.ViewModels.Project
@model ProjectUpdateViewModel
@{
	Layout = null;
}

<form asp-controller="Project" asp-action="Update" method="post"> 
	<div class="row row-gap-4 m-2">
        
        <input asp-for="UpdateModel.Id" type="hidden"/>
        <div class="col-md-6">
            <label class="form-label fw-semibold" asp-for="UpdateModel.Name">Name</label>
            <input class="form-control form-control-solid" asp-for="UpdateModel.Name" type="text"/>
            <span class="form_validation_feedback" asp-validation-for="UpdateModel.Name"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold" asp-for="UpdateModel.StartDate">Start Date</label>
            <input class="autoInitFlatPicker form-control form-control-solid" asp-for="UpdateModel.StartDate"/>
            <span class="form_validation_feedback" asp-validation-for="UpdateModel.StartDate"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold" asp-for="UpdateModel.Deadline">Deadline</label>
            <input class="autoInitFlatPicker form-control form-control-solid" asp-for="UpdateModel.Deadline"/>
            <span class="form_validation_feedback" asp-validation-for="UpdateModel.Deadline"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold" asp-for="UpdateModel.Description">Description</label>
            <input class="form-control form-control-solid" asp-for="UpdateModel.Description" type="text"/>
            <span class="form_validation_feedback" asp-validation-for="UpdateModel.Description"></span>
        </div>
	</div>
</form>