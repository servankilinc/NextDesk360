
@using ExpressDesk360.WebUI.Models.ViewModels.TicketMovement
@model TicketMovementUpdateViewModel
@{
	Layout = null;
}

<form asp-controller="TicketMovement" asp-action="Update" method="post"> 
	<div class="row row-gap-4 m-2">
        
        <input asp-for="UpdateModel.Id" type="hidden"/>
        <div class="col-md-6">
            <label class="form-label fw-semibold" asp-for="UpdateModel.TicketId">Ticket</label>
            <select class="autoInitSelect2 form-select form-select-solid" asp-items="Model.TicketIds" asp-for="UpdateModel.TicketId" data-control="select2"  data-allow-clear="true">
                <option></option>
            </select>
            <span class="form_validation_feedback" asp-validation-for="UpdateModel.TicketId"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold" asp-for="UpdateModel.TicketMovementTypeId">Ticket Movement Type</label>
            <select class="autoInitSelect2 form-select form-select-solid" asp-items="Model.TicketMovementTypeIds" asp-for="UpdateModel.TicketMovementTypeId" data-control="select2"  data-allow-clear="true">
                <option></option>
            </select>
            <span class="form_validation_feedback" asp-validation-for="UpdateModel.TicketMovementTypeId"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold" asp-for="UpdateModel.UserId">User</label>
            <select class="autoInitSelect2 form-select form-select-solid" asp-items="Model.UserIds" asp-for="UpdateModel.UserId" data-control="select2"  data-allow-clear="true">
                <option></option>
            </select>
            <span class="form_validation_feedback" asp-validation-for="UpdateModel.UserId"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold" asp-for="UpdateModel.ShippingId">Shipping</label>
            <select class="autoInitSelect2 form-select form-select-solid" asp-items="Model.ShippingIds" asp-for="UpdateModel.ShippingId" data-control="select2"  data-allow-clear="true">
                <option></option>
            </select>
            <span class="form_validation_feedback" asp-validation-for="UpdateModel.ShippingId"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold" asp-for="UpdateModel.FaultTypeId">Fault Type</label>
            <select class="autoInitSelect2 form-select form-select-solid" asp-items="Model.FaultTypeIds" asp-for="UpdateModel.FaultTypeId" data-control="select2"  data-allow-clear="true">
                <option></option>
            </select>
            <span class="form_validation_feedback" asp-validation-for="UpdateModel.FaultTypeId"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold" asp-for="UpdateModel.Date">Date</label>
            <input class="autoInitFlatPicker form-control form-control-solid" asp-for="UpdateModel.Date"/>
            <span class="form_validation_feedback" asp-validation-for="UpdateModel.Date"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold" asp-for="UpdateModel.Description">Description</label>
            <input class="form-control form-control-solid" asp-for="UpdateModel.Description" type="text"/>
            <span class="form_validation_feedback" asp-validation-for="UpdateModel.Description"></span>
        </div>
	</div>
</form>