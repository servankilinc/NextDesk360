
@using ExpressDesk360.WebUI.Models.ViewModels.TicketMessage
@model TicketMessageUpdateViewModel
@{
	Layout = null;
}

<form asp-controller="TicketMessage" asp-action="Update" method="post"> 
	<div class="row row-gap-4 m-2">
        
        <input asp-for="UpdateModel.Id" type="hidden"/>
        <div class="col-md-6">
            <label class="form-label fw-semibold" asp-for="UpdateModel.TicketId">Ticket</label>
            <select class="autoInitSelect2 form-select form-select-solid" asp-items="Model.TicketIds" asp-for="UpdateModel.TicketId" data-control="select2"  data-allow-clear="true">
                <option></option>
            </select>
            <span class="form_validation_feedback" asp-validation-for="UpdateModel.TicketId"></span>
        </div>
        <div class="col-md-6">
            <div class="form-check">
                <input class="form-check-input" asp-for="UpdateModel.IsSystem" type="checkbox" value=""/>
                <label class="form-check-label fw-semibold" asp-for="UpdateModel.IsSystem">Is System</label>
                <span class="form_validation_feedback" asp-validation-for="UpdateModel.IsSystem"></span>
            </div>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold" asp-for="UpdateModel.SenderId">Sender</label>
            <select class="autoInitSelect2 form-select form-select-solid" asp-items="Model.SenderIds" asp-for="UpdateModel.SenderId" data-control="select2"  data-allow-clear="true">
                <option></option>
            </select>
            <span class="form_validation_feedback" asp-validation-for="UpdateModel.SenderId"></span>
        </div>
        <div class="col-md-6">
            <div class="form-check">
                <input class="form-check-input" asp-for="UpdateModel.ExternalAccess" type="checkbox" value=""/>
                <label class="form-check-label fw-semibold" asp-for="UpdateModel.ExternalAccess">External Access</label>
                <span class="form_validation_feedback" asp-validation-for="UpdateModel.ExternalAccess"></span>
            </div>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold" asp-for="UpdateModel.Content">Content</label>
            <input class="form-control form-control-solid" asp-for="UpdateModel.Content" type="text"/>
            <span class="form_validation_feedback" asp-validation-for="UpdateModel.Content"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold" asp-for="UpdateModel.Date">Date</label>
            <input class="autoInitFlatPicker form-control form-control-solid" asp-for="UpdateModel.Date"/>
            <span class="form_validation_feedback" asp-validation-for="UpdateModel.Date"></span>
        </div>
	</div>
</form>