
@using ExpressDesk360.WebUI.Models.ViewModels.ProjectMovement
@model ProjectMovementCreateViewModel
@{
	Layout = null;
}

<form asp-controller="ProjectMovement" asp-action="Create" method="post"> 
	<div class="row row-gap-4 m-2">
        
        <div class="col-md-6">
            <label class="form-label fw-semibold" asp-for="CreateModel.ProjectId">Project</label>
            <select class="autoInitSelect2 form-select form-select-solid" asp-items="Model.ProjectIds" asp-for="CreateModel.ProjectId" data-control="select2"  data-allow-clear="true">
                <option></option>
            </select>
            <span class="form_validation_feedback" asp-validation-for="CreateModel.ProjectId"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold" asp-for="CreateModel.ProjectMovementTypeId">Project Movement Type</label>
            <select class="autoInitSelect2 form-select form-select-solid" asp-items="Model.ProjectMovementTypeIds" asp-for="CreateModel.ProjectMovementTypeId" data-control="select2"  data-allow-clear="true">
                <option></option>
            </select>
            <span class="form_validation_feedback" asp-validation-for="CreateModel.ProjectMovementTypeId"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold" asp-for="CreateModel.UserId">User</label>
            <select class="autoInitSelect2 form-select form-select-solid" asp-items="Model.UserIds" asp-for="CreateModel.UserId" data-control="select2"  data-allow-clear="true">
                <option></option>
            </select>
            <span class="form_validation_feedback" asp-validation-for="CreateModel.UserId"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold" asp-for="CreateModel.Date">Date</label>
            <input class="autoInitFlatPicker form-control form-control-solid" asp-for="CreateModel.Date"/>
            <span class="form_validation_feedback" asp-validation-for="CreateModel.Date"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold" asp-for="CreateModel.Description">Description</label>
            <input class="form-control form-control-solid" asp-for="CreateModel.Description" type="text"/>
            <span class="form_validation_feedback" asp-validation-for="CreateModel.Description"></span>
        </div>
	</div>
</form>