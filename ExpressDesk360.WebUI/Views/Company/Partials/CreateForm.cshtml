
@using ExpressDesk360.WebUI.Models.ViewModels.Company
@model CompanyCreateViewModel
@{
	Layout = null;
}

<form asp-controller="Company" asp-action="Create" method="post"> 
	<div class="row row-gap-4 m-2">
        
        <div class="col-md-6">
            <label class="form-label fw-semibold" asp-for="CreateModel.Name">Name</label>
            <input class="form-control form-control-solid" asp-for="CreateModel.Name" type="text"/>
            <span class="form_validation_feedback" asp-validation-for="CreateModel.Name"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold" asp-for="CreateModel.Address">Address</label>
            <input class="form-control form-control-solid" asp-for="CreateModel.Address" type="text"/>
            <span class="form_validation_feedback" asp-validation-for="CreateModel.Address"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold" asp-for="CreateModel.Fax">Fax</label>
            <input class="form-control form-control-solid" asp-for="CreateModel.Fax" type="text"/>
            <span class="form_validation_feedback" asp-validation-for="CreateModel.Fax"></span>
        </div>
        <div class="col-md-6">
            <div class="form-check">
                <input class="form-check-input" asp-for="CreateModel.ManagerApproval" type="checkbox" value=""/>
                <label class="form-check-label fw-semibold" asp-for="CreateModel.ManagerApproval">Manager Approval</label>
                <span class="form_validation_feedback" asp-validation-for="CreateModel.ManagerApproval"></span>
            </div>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold" asp-for="CreateModel.Description">Description</label>
            <input class="form-control form-control-solid" asp-for="CreateModel.Description" type="text"/>
            <span class="form_validation_feedback" asp-validation-for="CreateModel.Description"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold" asp-for="CreateModel.LogoUrl">Logo Url</label>
            <input class="form-control form-control-solid" asp-for="CreateModel.LogoUrl" type="text"/>
            <span class="form_validation_feedback" asp-validation-for="CreateModel.LogoUrl"></span>
        </div>
	</div>
</form>