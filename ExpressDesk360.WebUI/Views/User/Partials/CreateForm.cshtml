
@using ExpressDesk360.WebUI.Models.ViewModels.User
@model UserCreateViewModel
@{
	Layout = null;
}

<form asp-controller="User" asp-action="Create" method="post"> 
	<div class="row row-gap-4 m-2">
        
        <div class="col-md-6">
            <label class="form-label fw-semibold" asp-for="CreateModel.CompanyId">Company</label>
            <select class="autoInitSelect2 form-select form-select-solid" asp-items="Model.CompanyIds" asp-for="CreateModel.CompanyId" data-control="select2"  data-allow-clear="true">
                <option></option>
            </select>
            <span class="form_validation_feedback" asp-validation-for="CreateModel.CompanyId"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold" asp-for="CreateModel.UserName">User Name</label>
            <input class="form-control form-control-solid" asp-for="CreateModel.UserName" type="text"/>
            <span class="form_validation_feedback" asp-validation-for="CreateModel.UserName"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold" asp-for="CreateModel.Name">Name</label>
            <input class="form-control form-control-solid" asp-for="CreateModel.Name" type="text"/>
            <span class="form_validation_feedback" asp-validation-for="CreateModel.Name"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold" asp-for="CreateModel.SurName">Sur Name</label>
            <input class="form-control form-control-solid" asp-for="CreateModel.SurName" type="text"/>
            <span class="form_validation_feedback" asp-validation-for="CreateModel.SurName"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold" asp-for="CreateModel.HireDate">Hire Date</label>
            <input class="autoInitFlatPicker form-control form-control-solid" asp-for="CreateModel.HireDate"/>
            <span class="form_validation_feedback" asp-validation-for="CreateModel.HireDate"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold" asp-for="CreateModel.LogoUrl">Logo Url</label>
            <input class="form-control form-control-solid" asp-for="CreateModel.LogoUrl" type="text"/>
            <span class="form_validation_feedback" asp-validation-for="CreateModel.LogoUrl"></span>
        </div>
	</div>
</form>