
@using ExpressDesk360.WebUI.Models.ViewModels.ContactType
@model ContactTypeUpdateViewModel
@{
	Layout = null;
}

<form asp-controller="ContactType" asp-action="Update" method="post"> 
	<div class="row row-gap-4 m-2">
        
        <input asp-for="UpdateModel.Id" type="hidden"/>
        <div class="col-md-6">
            <label class="form-label fw-semibold" asp-for="UpdateModel.Name">Name</label>
            <input class="form-control form-control-solid" asp-for="UpdateModel.Name" type="text"/>
            <span class="form_validation_feedback" asp-validation-for="UpdateModel.Name"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold" asp-for="UpdateModel.Icon">Icon</label>
            <input class="form-control form-control-solid" asp-for="UpdateModel.Icon" type="text"/>
            <span class="form_validation_feedback" asp-validation-for="UpdateModel.Icon"></span>
        </div>
	</div>
</form>