
@using ExpressDesk360.WebUI.Models.ViewModels.StockGroup
@model StockGroupViewModel
@{
    ViewData["Title"] = "StockGroups";
}

@{
    ViewData["Breadcrumb"] = new Breadcrum
    {
        BreadcrumbItems = new List<BreadcrumbItem>
        {
            new BreadcrumbItem { Title = "Ana Sayfa", Path = Url.Action("Index", "Home") },
        },
        PageName = ViewData["Title"]?.ToString() ?? "Sayfa"
    };
}

<link href="~/metronic/plugins/custom/datatables/datatables.bundle.css" rel="stylesheet" />

<div class="card card-flush">
    <div class="card-header align-items-center py-5 gap-2 gap-md-5">
        <div class="card-title">
            <div class="menu menu-sub menu-sub-dropdown mt-2 w-75 w-lg-500px" data-kt-menu="true">
                <div class="px-7 py-5">
                    <div class="fs-5 text-gray-900 fw-bold">Filtreleme Seçenekleri</div>
                </div>
                <div class="separator border-gray-200"></div>
                <div class="px-7 py-5">
                    
                    <div class="mb-10">
                        <label class="form-label fw-semibold" for="inpt_name">Adı</label>
                        <input id="inpt_name" class="form-control form-control-sm form-control-solid" name="Name" type="text"/>
                    </div>
                    <div class="mb-10">
                        <div class="form-check form-switch form-switch-sm form-check-custom form-check-solid">
                            <input name="IsActive" value="true" type="hidden" />
                            <input name="IsActive" value="false" type="checkbox" class="form-check-input" />
                            <span class="form-check-label fs-sm">Pasifleri Göster</span>
                        </div>
                    </div>
            
                    <div class="d-flex justify-content-end">
                        <button type="reset" class="btn btn-sm btn-light btn-active-light-primary me-2" data-kt-menu-dismiss="true">Sıfırla</button>
                        <button type="button" onclick="InitilazeTable(this)" class="btn btn-sm btn-primary" data-kt-menu-dismiss="true">Uygula</button>
                    </div>
                </div>
            </div>
            <button class="btn btn-sm btn-flex btn-light-dark fw-bold" data-kt-menu-trigger="click" data-kt-menu-placement="bottom-start">
                <i class="ki-duotone ki-filter fs-6 text-muted me-1"><span class="path1"></span><span class="path2"></span></i>
                Filtrele
            </button>
        </div>
    </div>
    <div class="card-body p-4 pt-0">
        <table id="main_table" class="table align-middle table-row-dashed fs-6 gy-5">
            <thead>
                <tr class="text-start text-gray-500 fw-bold fs-7 text-uppercase gs-0">
                    <th>Grup Adı</th>
                    <th>Toplam Marka Sayısı</th>
                    <th>Toplam Arıza Tipi Sayısı</th>
                    <th>Toplam Stok Modeli Sayısı</th>
                    <th>Durum</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody class="fw-semibold text-gray-600">
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/metronic/plugins/custom/datatables/datatables.bundle.js"></script>

    <script>

        let mainTable;

        $(document).ready(function(){
            InitilazeTable();
        })

        function InitilazeTable(btn) {
            mainTable = DatatableManager.Create({
                serverSide: true,
                tableId: 'main_table',
                path: 'StockGroup/DatatableServerSide',
                method: 'Post',
                buttonElement: btn,
                
                requestData: {
                    filter: {
                        operator: 'base',
                        logic: 'and',
                        filters: [
                            {
                                operator: 'contains',
                                field: 'Name',
                                value: $("input[name='Name']").val()
                            },
                            {
                                operator: 'eq',
                                field: 'isActive',
                                value: !($('input[name="IsActive"]:checked').prop("checked") || false)
                            }
                        ]
                    }
                },
        
                columns: [
                    { data: 'name' },
                    { data: 'totalBrandCount' },
                    { data: 'totalFaultTypeCount' },
                    { data: 'totalStockModelCount' },
                    {
                        data: 'isActive',
                        render: function (data) {
                            if(data == true) return (`<span class="badge rounded-pill bg-label-success"><i class="fa-solid fa-check"></i> Aktif</span>`);
                            else if(data == false) return (`<span class="badge rounded-pill bg-label-danger"><i class="fa-solid fa-xmark"></i> Pasif</span>`);
                            else return ('');
                        }
                    },
                    {
                        data: null,
                        defaultContent: '',
                        searchable: false,
                        createdCell: function (td, cellData, rowData, row, col)
                        {
                            let detailBtn = document.createElement("a");
                            detailBtn.className = "btn btn-icon btn-bg-light btn-active-color-primary btn-sm me-1";
                            detailBtn.href = "/StockGroup/Detail/" + rowData.id;
                            detailBtn.innerHTML = '<i class="fa-solid fa-magnifying-glass"></i>';
                            detailBtn.title = "Detay";

                            let btnContainer = document.createElement("div");
                            btnContainer.className = "d-flex justify-content-end flex-shrink-0";
                            btnContainer.appendChild(detailBtn);

                            let updateBtn = HelperService.UpdateButtonTable({
                                title: 'Stok Grubu Güncelle',
                                formGetterUrl: 'StockGroup/Update',
                                requestData: {
                                    "id": rowData.id
                                },
                                pageTable: mainTable
                            });

                            let parser = new DOMParser();
                            let updateBtnEl = parser.parseFromString(updateBtn, "text/html").body.firstChild;
                            btnContainer.appendChild(updateBtnEl);
                            
                            td.innerHTML = "";
                            td.appendChild(btnContainer);
                        }
                    }
                ],
                customButtons:
                [  
                    {
                        text: '<span class="dynamic-content"><i class="fa-solid fa-file-circle-plus me-2"></i>Yeni Stok Grubu Ekle</span>',
                        className: 'btn btn-primary mx-2',
                        action: (e_btn) =>
                        {
                            HelperService.InsertModal({
                                title: 'Yeni Stok Grubu Ekle',
                                formGetterUrl: 'StockGroup/Create',
                                e_btn: e_btn.currentTarget,
                                pageTable: mainTable
                            })
                        }
                    }
                ]
            })
        }
    </script>
}
