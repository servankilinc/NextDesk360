@using ExpressDesk360.WebUI.Models.ViewModels.StockGroup
@model StockGroupUpdateViewModel
@{
	Layout = null;
}

<form asp-controller="StockGroup" asp-action="Update" method="post"> 
	<div class="row row-gap-4 m-2">
        
        <input asp-for="UpdateModel.Id" type="hidden"/>
        <div class="col-md-12">
            <label class="form-label fw-semibold" asp-for="UpdateModel.Name">Grup Adı</label>
            <input class="form-control form-control-solid" asp-for="UpdateModel.Name" type="text"/>
            <span class="form_validation_feedback" asp-validation-for="UpdateModel.Name"></span>
        </div>
        <div class="col-md-12">
            <label class="form-label fw-semibold" asp-for="UpdateModel.BrandIds">Markalar</label>
            <select class="autoInitSelect2 form-select form-select-solid" asp-items="Model.BrandIds" asp-for="UpdateModel.BrandIds" data-control="select2" data-placeholder="Marka Seçin" data-allow-clear="true" multiple="multiple">
                <option></option>
            </select>
            <span class="form_validation_feedback" asp-validation-for="UpdateModel.BrandIds"></span>
        </div>
        <div class="col-md-12">
            <label class="form-label fw-semibold" asp-for="UpdateModel.FaultTypeIds">Arıza Tipleri</label>
            <select class="autoInitSelect2 form-select form-select-solid" asp-items="Model.FaultTypeIds" asp-for="UpdateModel.FaultTypeIds" data-control="select2" data-placeholder="Arıza Tipi Seçin" data-allow-clear="true" multiple="multiple">
                <option></option>
            </select>
            <span class="form_validation_feedback" asp-validation-for="UpdateModel.FaultTypeIds"></span>
        </div>

        <div class="col-md-12">
            <label class="form-label fw-semibold" asp-for="UpdateModel.IsActive">Durum</label>
            <div class="form-check form-switch form-switch-sm form-check-custom form-check-solid">
                <input class="form-check-input" type="checkbox" asp-for="UpdateModel.IsActive" />
                <label class="form-check-label" asp-for="UpdateModel.IsActive">Aktif Mi?</label>
            </div>
            <span class="form_validation_feedback" asp-validation-for="UpdateModel.IsActive"></span>
        </div>
	</div>
</form>