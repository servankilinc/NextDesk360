@using ExpressDesk360.WebUI.Models.ViewModels.StockGroup
@model StockGroupDetailViewModel
@{
    ViewData["Title"] = "Stok Grubu Detayı";
}

@{
    ViewData["Breadcrumb"] = new Breadcrum
    {
        BreadcrumbItems = new List<BreadcrumbItem>
        {
            new BreadcrumbItem { Title = "Ana Sayfa", Path = Url.Action("Index", "Home") },
            new BreadcrumbItem { Title = "Stok Grupları", Path = Url.Action("Index", "StockGroup") }
        },
        PageName = Model.StockGroup?.Name ?? "Detay"
    };
}

<div class="card mb-5 mb-xl-10">
    <div class="card-header cursor-pointer">
        <div class="card-title m-0">
            <h3 class="fw-bold m-0">Stok Grubu Bilgileri</h3>
        </div>
        <a href="javascript:void(0)" onclick="HelperService.InsertModal({ title: 'Stok Grubu Güncelle', formGetterUrl: 'StockGroup/Update', requestData: { id: '@Model.StockGroup?.Id' } })" class="btn btn-sm btn-primary align-self-center">Düzenle</a>
    </div>

    <div class="card-body p-9">
        <div class="row mb-7">
            <label class="col-lg-4 fw-semibold text-muted">Grup Adı</label>
            <div class="col-lg-8">
                <span class="fw-bold fs-6 text-gray-800">@Model.StockGroup?.Name</span>
            </div>
        </div>
    </div>
</div>

<div class="row g-5 g-xl-8">
    <div class="col-xl-6">
        <div class="card card-xl-stretch mb-5 mb-xl-8">
            <div class="card-header border-0 pt-5">
                <h3 class="card-title align-items-start flex-column">
                    <span class="card-label fw-bold fs-3 mb-1">İlişkili Markalar</span>
                </h3>
            </div>
            <div class="card-body py-3">
                <div class="table-responsive">
                    <table class="table table-row-dashed table-row-gray-300 align-middle gs-0 gy-4">
                        <thead>
                            <tr class="fw-bold text-muted">
                                <th>Marka Adı</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.StockGroup?.StockGroupBrandMaps != null && Model.StockGroup.StockGroupBrandMaps.Any())
                            {
                                foreach (var map in Model.StockGroup.StockGroupBrandMaps)
                                {
                                    <tr>
                                        <td>
                                            <span class="text-dark fw-bold d-block fs-6">@map.StockBrand?.Name</span>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td class="text-center text-muted fw-semibold py-5">
                                        Henüz ilişkilendirilmiş marka bulunmuyor.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-6">
        <div class="card card-xl-stretch mb-5 mb-xl-8">
            <div class="card-header border-0 pt-5">
                <h3 class="card-title align-items-start flex-column">
                    <span class="card-label fw-bold fs-3 mb-1">İlişkili Arıza Tipleri</span>
                </h3>
            </div>
            <div class="card-body py-3">
                <div class="table-responsive">
                    <table class="table table-row-dashed table-row-gray-300 align-middle gs-0 gy-4">
                        <thead>
                            <tr class="fw-bold text-muted">
                                <th>Arıza Tipi</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.StockGroup?.StockGroupFaultTypeMaps != null && Model.StockGroup.StockGroupFaultTypeMaps.Any())
                            {
                                foreach (var map in Model.StockGroup.StockGroupFaultTypeMaps)
                                {
                                    <tr>
                                        <td>
                                            <span class="text-dark fw-bold d-block fs-6">@map.FaultType?.Name</span>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td class="text-center text-muted fw-semibold py-5">
                                        Henüz ilişkilendirilmiş arıza tipi bulunmuyor.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
