
@using ExpressDesk360.WebUI.Models.ViewModels._TaskFile
@model _TaskFileUpdateViewModel
@{
	Layout = null;
}

<form asp-controller="_TaskFile" asp-action="Update" method="post"> 
	<div class="row row-gap-4 m-2">
        
        <input asp-for="UpdateModel.Id" type="hidden"/>
        <div class="col-md-6">
            <label class="form-label fw-semibold" asp-for="UpdateModel.TaskId">Task</label>
            <select class="autoInitSelect2 form-select form-select-solid" asp-items="Model.TaskIds" asp-for="UpdateModel.TaskId" data-control="select2"  data-allow-clear="true">
                <option></option>
            </select>
            <span class="form_validation_feedback" asp-validation-for="UpdateModel.TaskId"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold" asp-for="UpdateModel.FileId">File</label>
            <select class="autoInitSelect2 form-select form-select-solid" asp-items="Model.FileIds" asp-for="UpdateModel.FileId" data-control="select2"  data-allow-clear="true">
                <option></option>
            </select>
            <span class="form_validation_feedback" asp-validation-for="UpdateModel.FileId"></span>
        </div>
	</div>
</form>