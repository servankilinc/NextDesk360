
@using ExpressDesk360.WebUI.Models.ViewModels.FSFolder
@model FSFolderUpdateViewModel
@{
	Layout = null;
}

<form asp-controller="FSFolder" asp-action="Update" method="post"> 
	<div class="row row-gap-4 m-2">
        
        <input asp-for="UpdateModel.Id" type="hidden"/>
        <div class="col-md-6">
            <label class="form-label fw-semibold" asp-for="UpdateModel.OwnerId">Owner</label>
            <select class="autoInitSelect2 form-select form-select-solid" asp-items="Model.OwnerIds" asp-for="UpdateModel.OwnerId" data-control="select2"  data-allow-clear="true">
                <option></option>
            </select>
            <span class="form_validation_feedback" asp-validation-for="UpdateModel.OwnerId"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold" asp-for="UpdateModel.ParentFolderId">Parent Folder</label>
            <select class="autoInitSelect2 form-select form-select-solid" asp-items="Model.ParentFolderIds" asp-for="UpdateModel.ParentFolderId" data-control="select2"  data-allow-clear="true">
                <option></option>
            </select>
            <span class="form_validation_feedback" asp-validation-for="UpdateModel.ParentFolderId"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold" asp-for="UpdateModel.Name">Name</label>
            <input class="form-control form-control-solid" asp-for="UpdateModel.Name" type="text"/>
            <span class="form_validation_feedback" asp-validation-for="UpdateModel.Name"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold" asp-for="UpdateModel.Path">Path</label>
            <input class="form-control form-control-solid" asp-for="UpdateModel.Path" type="text"/>
            <span class="form_validation_feedback" asp-validation-for="UpdateModel.Path"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold" asp-for="UpdateModel.CreateDate">Create Date</label>
            <input class="autoInitFlatPicker form-control form-control-solid" asp-for="UpdateModel.CreateDate"/>
            <span class="form_validation_feedback" asp-validation-for="UpdateModel.CreateDate"></span>
        </div>
	</div>
</form>