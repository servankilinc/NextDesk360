
@using ExpressDesk360.WebUI.Models.ViewModels.BOM
@model BOMCreateViewModel
@{
	Layout = null;
}

<form asp-controller="BOM" asp-action="Create" method="post"> 
	<div class="row row-gap-4 m-2">
        
        <div class="col-md-6">
            <label class="form-label fw-semibold" asp-for="CreateModel.StockId">Stock</label>
            <select class="autoInitSelect2 form-select form-select-solid" asp-items="Model.StockIds" asp-for="CreateModel.StockId" data-control="select2"  data-allow-clear="true">
                <option></option>
            </select>
            <span class="form_validation_feedback" asp-validation-for="CreateModel.StockId"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold" asp-for="CreateModel.VersionName">Version Name</label>
            <input class="form-control form-control-solid" asp-for="CreateModel.VersionName" type="text"/>
            <span class="form_validation_feedback" asp-validation-for="CreateModel.VersionName"></span>
        </div>
        <div class="col-md-6">
            <div class="form-check">
                <input class="form-check-input" asp-for="CreateModel.Status" type="checkbox" value=""/>
                <label class="form-check-label fw-semibold" asp-for="CreateModel.Status">Status</label>
                <span class="form_validation_feedback" asp-validation-for="CreateModel.Status"></span>
            </div>
        </div>
	</div>
</form>