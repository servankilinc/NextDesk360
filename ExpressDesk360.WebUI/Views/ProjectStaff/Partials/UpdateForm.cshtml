
@using ExpressDesk360.WebUI.Models.ViewModels.ProjectStaff
@model ProjectStaffUpdateViewModel
@{
	Layout = null;
}

<form asp-controller="ProjectStaff" asp-action="Update" method="post"> 
	<div class="row row-gap-4 m-2">
        
        <input asp-for="UpdateModel.Id" type="hidden"/>
        <div class="col-md-6">
            <label class="form-label fw-semibold" asp-for="UpdateModel.ProjectId">Project</label>
            <select class="autoInitSelect2 form-select form-select-solid" asp-items="Model.ProjectIds" asp-for="UpdateModel.ProjectId" data-control="select2"  data-allow-clear="true">
                <option></option>
            </select>
            <span class="form_validation_feedback" asp-validation-for="UpdateModel.ProjectId"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold" asp-for="UpdateModel.UserId">User</label>
            <select class="autoInitSelect2 form-select form-select-solid" asp-items="Model.UserIds" asp-for="UpdateModel.UserId" data-control="select2"  data-allow-clear="true">
                <option></option>
            </select>
            <span class="form_validation_feedback" asp-validation-for="UpdateModel.UserId"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold" asp-for="UpdateModel.JoinedDate">Joined Date</label>
            <input class="autoInitFlatPicker form-control form-control-solid" asp-for="UpdateModel.JoinedDate"/>
            <span class="form_validation_feedback" asp-validation-for="UpdateModel.JoinedDate"></span>
        </div>
	</div>
</form>