
@using ExpressDesk360.WebUI.Models.ViewModels.CompanyProductStockSerialMap
@model CompanyProductStockSerialMapUpdateViewModel
@{
	Layout = null;
}

<form asp-controller="CompanyProductStockSerialMap" asp-action="Update" method="post"> 
	<div class="row row-gap-4 m-2">
        
        <input asp-for="UpdateModel.Id" type="hidden"/>
        <div class="col-md-6">
            <label class="form-label fw-semibold" asp-for="UpdateModel.CompanyProductId">Company Product</label>
            <select class="autoInitSelect2 form-select form-select-solid" asp-items="Model.CompanyProductIds" asp-for="UpdateModel.CompanyProductId" data-control="select2"  data-allow-clear="true">
                <option></option>
            </select>
            <span class="form_validation_feedback" asp-validation-for="UpdateModel.CompanyProductId"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold" asp-for="UpdateModel.StockSerialId">Stock Serial</label>
            <select class="autoInitSelect2 form-select form-select-solid" asp-items="Model.StockSerialIds" asp-for="UpdateModel.StockSerialId" data-control="select2"  data-allow-clear="true">
                <option></option>
            </select>
            <span class="form_validation_feedback" asp-validation-for="UpdateModel.StockSerialId"></span>
        </div>
	</div>
</form>